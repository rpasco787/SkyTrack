hs_err_pid*
replay_pid*
.vscode

# macOS
.DS_Store

# Local docs (plans, results, roadmaps) — not tracked, except the public ones
# referenced by the README so they resolve on GitHub.
docs/*
!docs/architecture.md
!docs/adr/
!docs/2026-06-16-synthetic-schedule-demo-results.md
!docs/2026-06-06-chunk7-pipeline-smoke-test-results.md
!docs/backtest-results-*.md
!docs/img/
!docs/img/**

skytrack-learning-roadmap.md
.gitignore
data/*
!data/recorded-weather/
!data/recorded-weather/**

# LocalStack
localstack/volume/
.localstack/

# Generated WireMock schedule stubs (regenerate via WireMockStubGeneratorIT)
wiremock/generated/
# Large local datasets (BTS on-time CSV is ~190MB, airports is a symlink to data/)
skytrack/data/bts/
skytrack/data/airports
soak-results/
